+        assert_eq!(
+            old.retire_scope_callbacks(1, "old"),
+            Err(ProtocolError::StaleScope)
+        );
+        root.sequence
+            .lock()
+            .unwrap()
+            .scope_gates
+            .insert(key, registered);
