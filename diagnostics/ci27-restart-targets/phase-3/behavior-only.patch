+            return Err(ProtocolError::ScopeUnavailable);
+        }
+        if configuring || !enrollment_ready {
+            return Ok(None);
+        }
+        // Preserve the original full-inventory contract at the final boundary.
+        if !state.inventory_complete() {
+            return Err(ProtocolError::ScopeUnavailable);
+        }
