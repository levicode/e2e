{
  "name": "@e2e-dev/uat-verification",
  "version": "0.0.0",
  "private": true,
  "description": "Local UAT verification loop: a reusable scanned-in session, a scripted read-only baseline, a real-model path, and redacted reports",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "fixed": "node scripts/fixed-checkout.ts",
    "login": "node scripts/login.ts",
    "verify": "node scripts/verify.ts scripted",
    "verify:engine": "node scripts/verify.ts scripted --browser engine",
    "verify:cdp": "node scripts/verify.ts scripted --browser cdp",
    "verify:model": "node scripts/verify.ts model",
    "verify:model:engine": "node scripts/verify.ts model --browser engine",
    "verify:model:cdp": "node scripts/verify.ts model --browser cdp",
    "native:record": "node scripts/record-native-build.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:loop": "node test/loop-check.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.102",
    "@e2e-dev/web": "workspace:*",
    "ai": "7.0.153",
    "e2e": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
