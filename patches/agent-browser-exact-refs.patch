+/// Scope IDs are opaque: do not trim, case-fold, or infer a default context.
+fn is_valid_cdp_scope_id(value: &str) -> bool {
+    !value.is_empty()
+        && !value.starts_with("--")
+        && !value.chars().any(|c| c.is_whitespace() || c.is_control())
