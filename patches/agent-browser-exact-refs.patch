+            map.add_with_frame("e2".into(), Some(43), "button", "Save", None, None);
+            let error = if center {
+                resolve_element_center(&client, "page-session", &map, "@e1", &HashMap::new()).await.unwrap_err()
+            } else {
+                resolve_element_object_id(&client, "page-session", &map, "@e1", &HashMap::new()).await.unwrap_err()
+            };
+            assert_eq!(error, "e2e_node_stale:e1");
+            server.await.unwrap();
+        }
+    }
