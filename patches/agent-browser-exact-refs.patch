+fn exact_ref_frame_in_tree(tree: &Value, frame_id: &str) -> bool {
+    tree["frame"]["id"].as_str() == Some(frame_id)
+        || tree["childFrames"].as_array().is_some_and(|children| children.iter().any(|child| exact_ref_frame_in_tree(child, frame_id)))
