+    /// An ordinary websocket fixture, with no Chrome process. Foreign and
+    /// same-context sibling targets are deliberately listed before the selected
+    /// target so an unfiltered attach/probe fallback is visible on the wire.
+    async fn strict_scope_sentinel(
+        mode: StrictScopeSentinelMode,
+    ) -> (
+        String,
+        Arc<std::sync::Mutex<Vec<Value>>>,
+        tokio::task::JoinHandle<()>,
+    ) {
+        use futures_util::{SinkExt, StreamExt};
+        use tokio_tungstenite::tungstenite::Message;
+
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("ws://{}/devtools/browser/scope-sentinel", listener.local_addr().unwrap());
+        let recorded = Arc::new(std::sync::Mutex::new(Vec::new()));
+        let events = recorded.clone();
+        let server = tokio::spawn(async move {
+            let (stream, _) = listener.accept().await.unwrap();
+            let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+            let mut context_reads = 0;
+            loop {
+                let message = tokio::time::timeout(Duration::from_secs(15), ws.next())
+                    .await.expect("scope fixture connection did not close");
+                let text = match message {
+                    Some(Ok(Message::Text(text))) => text,
+                    Some(Ok(Message::Ping(payload))) => {
+                        let _ = ws.send(Message::Pong(payload)).await;
+                        continue;
+                    }
+                    Some(Ok(Message::Close(_))) | None | Some(Err(_)) => break,
+                    _ => continue,
+                };
+                let command: Value = serde_json::from_str(&text).unwrap();
+                events.lock().unwrap().push(command.clone());
+                let method = command["method"].as_str().unwrap_or("");
+                let sid = command["sessionId"].as_str();
+                if matches!(mode, StrictScopeSentinelMode::Unresponsive)
+                    && sid == Some("S-T-SELECTED")
+                    && method == "Runtime.evaluate"
+                {
+                    continue;
+                }
+                let result = match method {
+                    "Target.getBrowserContexts" => {
+                        context_reads += 1;
+                        match mode {
+                            StrictScopeSentinelMode::DefaultMetadata | StrictScopeSentinelMode::DefaultForeign => {
+                                json!({"browserContextIds":["C-FOREIGN","C-APPROVED"],"defaultBrowserContextId":"C-DEFAULT"})
+                            }
+                            StrictScopeSentinelMode::DefaultMetadataInvalid => {
+                                json!({"browserContextIds":["C-FOREIGN","C-APPROVED"],"defaultBrowserContextId":" invalid context "})
+                            }
+                            StrictScopeSentinelMode::DefaultMetadataAbsent => {
+                                json!({"browserContextIds":["C-DEFAULT","C-FOREIGN","C-APPROVED"]})
+                            }
+                            StrictScopeSentinelMode::DefaultAmbiguous | StrictScopeSentinelMode::DefaultLegacyConflict => {
+                                json!({"browserContextIds":["C-FOREIGN"]})
+                            }
+                            StrictScopeSentinelMode::DefaultRacingIncognito if context_reads > 1 => {
+                                json!({"browserContextIds":["C-DEFAULT","C-FOREIGN","C-APPROVED"]})
+                            }
+                            _ => json!({"browserContextIds":["C-FOREIGN","C-APPROVED"]}),
+                        }
+                    },
+                    "Target.getTargets" => {
+                        let mut targets = vec![
+                            json!({"targetId":"T-FOREIGN","type":"page","title":"foreign", "url":"https://foreign.test/","browserContextId":"C-FOREIGN"}),
+                            json!({"targetId":"T-SIBLING","type":"page","title":"sibling", "url":"https://sibling.test/","browserContextId":"C-APPROVED"}),
+                            json!({"targetId":"T-DEFAULT","type":"page","title":"default", "url":"https://default.test/"}),
+                        ];
+                        if !matches!(mode, StrictScopeSentinelMode::Missing) {
+                            let context = match mode {
+                                StrictScopeSentinelMode::Mismatched | StrictScopeSentinelMode::DefaultForeign => "C-FOREIGN",
+                                StrictScopeSentinelMode::DefaultMetadata
+                                | StrictScopeSentinelMode::DefaultMetadataAbsent
+                                | StrictScopeSentinelMode::DefaultMetadataInvalid
+                                | StrictScopeSentinelMode::DefaultProvenUnique
+                                | StrictScopeSentinelMode::DefaultAmbiguous
+                                | StrictScopeSentinelMode::DefaultRacingIncognito => "C-DEFAULT",
+                                _ => "C-APPROVED",
+                            };
+                            let mut selected = json!({"targetId":"T-SELECTED","type":"page", "title":"selected","url":"https://selected.test/","browserContextId":context});
+                            if matches!(mode, StrictScopeSentinelMode::DefaultAbsentContext | StrictScopeSentinelMode::DefaultLegacyConflict) {
+                                selected.as_object_mut().unwrap().remove("browserContextId");
+                            }
+                            targets.push(selected);
+                        }
+                        json!({"targetInfos": targets})
+                    }
+                    "Target.attachToTarget" => {
+                        let target = command["params"]["targetId"].as_str().unwrap_or("");
+                        json!({"sessionId":format!("S-{target}")})
+                    }
+                    "Runtime.evaluate" => json!({"result":{"type":"number","value":1}}),
+                    "Target.createTarget" => json!({"targetId":"T-UNEXPECTED-CREATED"}),
+                    _ => json!({}),
+                };
+                let response = json!({"id":command["id"],"result":result});
+                if ws.send(Message::Text(response.to_string())).await.is_err() {
+                    break;
+                }
+            }
+        });
+        (url, recorded, server)
+    }
+
+    fn assert_strict_scope_wire_boundary(commands: &[Value]) {
+        for command in commands {
+            let method = command["method"].as_str().unwrap_or("");
+            assert!(
+                !matches!(method, "Target.createTarget" | "Target.createBrowserContext" | "Target.activateTarget" | "Browser.close"),
+                "scoped connect escaped through {command}"
+            );
+            if method == "Target.attachToTarget" {
+                assert_eq!(command["params"]["targetId"], "T-SELECTED", "foreign/sibling attachment: {command}");
+            }
+            if let Some(sid) = command["sessionId"].as_str() {
+                assert_eq!(sid, "S-T-SELECTED", "foreign/sibling session command: {command}");
+            }
+            if method == "Target.setAutoAttach" {
+                assert_eq!(command["sessionId"], "S-T-SELECTED", "browser-wide auto-attach: {command}");
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn test_cdp_scope_connect_wire_sentinel_only_selected_target_and_deferred_domains() {
+        let (url, recorded, server) = strict_scope_sentinel(StrictScopeSentinelMode::Matching).await;
+        let mut manager = tokio::time::timeout(
+            Duration::from_secs(10),
+            BrowserManager::connect_cdp_scoped(&url, Some(strict_scope(Some("C-APPROVED")))),
+        ).await.expect("scoped connect timed out").expect("selected target should connect");
+        assert_eq!(manager.pages.len(), 1);
+        assert_eq!(manager.active_target_id().unwrap(), "T-SELECTED");
+        assert!(manager.scope_guard().accepts_session(Some("S-T-SELECTED")));
+        {
+            let commands = recorded.lock().unwrap();
+            assert_strict_scope_wire_boundary(&commands);
+            assert!(commands.iter().any(|c| c["method"] == "Target.attachToTarget"));
+            assert!(commands.iter().any(|c| c["method"] == "Runtime.evaluate"));
+            assert!(!commands.iter().any(|c| matches!(c["method"].as_str(), Some("Page.enable" | "Runtime.enable" | "Network.enable" | "Target.setAutoAttach"))), "scoped domains must wait until event subscribers exist");
+        }
+        let _subscribed = manager.client.subscribe();
+        manager.enable_active_scoped_domains().await.expect("enable scoped domains");
+        manager.enable_browser_auto_attach_pub().await.expect("scoped browser auto-attach must be a no-op");
+        manager.remove_page_by_target_id("T-SELECTED");
+        let _ = manager.ensure_page().await;
+        assert!(manager.pages.is_empty(), "empty scope silently created a fallback page");
+        manager.close().await.unwrap();
+        tokio::time::timeout(Duration::from_secs(3), server).await.unwrap().unwrap();
+        let commands = recorded.lock().unwrap();
+        assert_strict_scope_wire_boundary(&commands);
+        assert!(commands.iter().any(|c| c["method"] == "Page.enable"));
+    }
+
+    #[tokio::test]
+    async fn test_cdp_scope_default_sentinel_requires_explicit_or_unique_non_incognito_proof() {
+        for (mode, expected_success, resolved_context) in [
+            (StrictScopeSentinelMode::DefaultMetadata, true, Some("C-DEFAULT")),
+            (StrictScopeSentinelMode::DefaultForeign, false, Some("C-DEFAULT")),
+            (StrictScopeSentinelMode::DefaultMetadataAbsent, false, None),
+            (StrictScopeSentinelMode::DefaultMetadataInvalid, false, None),
+            (StrictScopeSentinelMode::DefaultAbsentContext, true, None),
+            (StrictScopeSentinelMode::DefaultProvenUnique, true, Some("C-DEFAULT")),
+            (StrictScopeSentinelMode::DefaultAmbiguous, false, None),
+            (StrictScopeSentinelMode::DefaultRacingIncognito, false, None),
+            (StrictScopeSentinelMode::DefaultLegacyConflict, false, Some("C-APPROVED")),
+        ] {
+            let (url, recorded, server) = strict_scope_sentinel(mode).await;
+            let result = tokio::time::timeout(
+                Duration::from_secs(10),
+                BrowserManager::connect_cdp_scoped(&url, Some(strict_scope(None))),
+            ).await.expect("default-context resolution timed out");
+            if expected_success {
+                let mut manager = result.expect("verified default context should connect");
+                assert_eq!(manager.active_target_id().unwrap(), "T-SELECTED");
+                let guard = manager.scope_guard();
+                assert!(guard.accepts_target(&strict_scope_target("T-DEFAULT-PAGE", "page", resolved_context)));
+                assert!(!guard.accepts_target(&strict_scope_target("T-FOREIGN-PAGE", "page", Some("C-FOREIGN"))));
+                if resolved_context.is_some() {
+                    assert!(!guard.accepts_target(&strict_scope_target("T-UNRESOLVED", "page", None)));
+                } else {
+                    assert!(!guard.accepts_target(&strict_scope_target("T-UNVERIFIED", "page", Some("C-DEFAULT"))));
+                }
+                assert!(manager.scope_guard.scope.as_ref().unwrap().context_id.is_none(), "resolved metadata must not rewrite default-context command semantics");
+                assert_eq!(manager.scope_guard.resolved_default_context.as_deref(), resolved_context);
+                assert!(manager.target_parameters("about:blank").get("browserContextId").is_none(), "default-context createTarget must omit the incognito context parameter");
+                manager.close().await.unwrap();
+            } else {
+                assert!(result.is_err(), "foreign or unverified concrete context must fail before attach");
+            }
+            tokio::time::timeout(Duration::from_secs(3), server).await.unwrap().unwrap();
+            let commands = recorded.lock().unwrap();
+            assert_strict_scope_wire_boundary(&commands);
+            let context_reads: Vec<usize> = commands.iter().enumerate().filter_map(|(index, command)| (command["method"] == "Target.getBrowserContexts").then_some(index)).collect();
+            let targets_at = commands.iter().position(|c| c["method"] == "Target.getTargets").unwrap();
+            assert_eq!(context_reads.len(), 2, "default proof must bracket target enumeration");
+            assert!(context_reads[0] < targets_at && targets_at < context_reads[1]);
+            if !expected_success {
+                assert!(!commands.iter().any(|c| c["method"] == "Target.attachToTarget" || c["sessionId"].is_string()), "unverified default selection caused attach/probe/domain work: {commands:?}");
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn test_cdp_scope_connect_wire_sentinel_missing_or_mismatch_fail_before_attach() {
+        for mode in [StrictScopeSentinelMode::Missing, StrictScopeSentinelMode::Mismatched] {
+            let (url, recorded, server) = strict_scope_sentinel(mode).await;
+            let result = tokio::time::timeout(
+                Duration::from_secs(10),
+                BrowserManager::connect_cdp_scoped(&url, Some(strict_scope(Some("C-APPROVED")))),
+            ).await.expect("scope validation timed out");
+            assert!(result.is_err(), "missing/mismatched initial target must fail closed");
+            tokio::time::timeout(Duration::from_secs(3), server).await.unwrap().unwrap();
+            let commands = recorded.lock().unwrap();
+            assert_strict_scope_wire_boundary(&commands);
+            assert!(!commands.iter().any(|c| c["method"] == "Target.attachToTarget" || c["sessionId"].is_string()), "validation must precede every attach/probe/domain command: {commands:?}");
+        }
+    }
+
+    #[tokio::test]
+    async fn test_cdp_scope_connect_wire_sentinel_unresponsive_never_revives_or_falls_back() {
+        let (url, recorded, server) = strict_scope_sentinel(StrictScopeSentinelMode::Unresponsive).await;
+        let result = tokio::time::timeout(
+            Duration::from_secs(10),
+            BrowserManager::connect_cdp_scoped(&url, Some(strict_scope(Some("C-APPROVED")))),
+        ).await.expect("unresponsive scoped connect must fail promptly");
+        assert!(result.is_err(), "an unresponsive selected target must fail closed");
+        tokio::time::timeout(Duration::from_secs(3), server).await.unwrap().unwrap();
+        let commands = recorded.lock().unwrap();
+        assert_strict_scope_wire_boundary(&commands);
+        assert!(commands.iter().any(|c| c["method"] == "Runtime.evaluate"));
+        assert!(!commands.iter().any(|c| c["method"] == "Page.enable"), "no domain setup after failed selected-target probe");
+    }
+
 }
