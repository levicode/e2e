+fn exact_ref_frame_in_tree(tree: &Value, frame_id: &str) -> bool {
+    tree["frame"]["id"].as_str() == Some(frame_id)
+        || tree["childFrames"].as_array().is_some_and(|children| children.iter().any(|child| exact_ref_frame_in_tree(child, frame_id)))
+}
+
+/// Registers a same-target backend node through the public CLI, never by role/name.
+async fn handle_exact_ref(cmd: &Value, state: &mut DaemonState) -> Result<Value, String> {
+    let backend_id = cmd.get("backendNodeId").and_then(Value::as_i64)
+        .filter(|value| *value > 0).ok_or("Invalid backend node id")?;
+    let frame_id = cmd.get("frameId").and_then(Value::as_str);
+    let mgr = state.browser.as_ref().ok_or("Browser not launched")?;
+    let session_id = mgr.active_session_id()?.to_string();
+    let tree=mgr.client.send_command_no_params("Page.getFrameTree",Some(&session_id)).await?;
+    let requested=frame_id.or_else(||tree["frameTree"]["frame"]["id"].as_str()).ok_or("Active frame is unavailable")?;
+    if !exact_ref_frame_in_tree(&tree["frameTree"],requested){return Err("Exact ref frame does not belong to the active page".into());}
+    let mut sessions=vec![session_id.clone()];sessions.extend(state.iframe_sessions.values().cloned());sessions.sort();sessions.dedup();
+    let mut binding=None;
+    for candidate in sessions {
+        let Ok(world)=mgr.client.send_command("Page.createIsolatedWorld",Some(json!({"frameId":requested,"worldName":"agent-browser-exact-refs"})),Some(&candidate)).await else {continue;};
+        let Some(context)=world["executionContextId"].as_i64() else {continue;};
+        let Ok(resolved)=mgr.client.send_command("DOM.resolveNode",Some(json!({"backendNodeId":backend_id,"executionContextId":context})),Some(&candidate)).await else {continue;};
+        let Some(object)=resolved["object"]["objectId"].as_str() else {continue;};
+        let checked=mgr.client.send_command("Runtime.callFunctionOn",Some(json!({"objectId":object,"functionDeclaration":"function(){return this.nodeType===1&&this.isConnected&&this.ownerDocument===document}","returnByValue":true})),Some(&candidate)).await;
+        let _=mgr.client.send_command("Runtime.releaseObject",Some(json!({"objectId":object})),Some(&candidate)).await;
+        if checked.as_ref().ok().and_then(|value|value["result"]["value"].as_bool())==Some(true){binding=Some((candidate,context));break;}
+    }
+    let (bound_session,context_id)=binding.ok_or("Exact backend node does not belong to the requested connected document")?;
+    // Resolving through the active target session (or its attached frame session)
+    // rejects backend ids from a different tab. Connectedness is checked before
+    // publishing the ref; the normal action path checks it again at dispatch.
+    let next = state.ref_map.next_ref_num();
+    let ref_id = format!("e{next}");
+    state.ref_map.set_next_ref_num(next + 1);
+    state.ref_map.add_with_frame(ref_id.clone(), Some(backend_id), "", "", None, frame_id);
+    state.ref_map.bind_world(&ref_id,&bound_session,context_id);
+    if let Err(error) = super::element::resolve_element_object_id(
+        &mgr.client, &session_id, &state.ref_map, &format!("@{ref_id}"), &state.iframe_sessions,
+    ).await {
+        state.ref_map.remove(&ref_id);
+        return Err(error);
+    }
+    Ok(json!({"ref":ref_id,"backendNodeId":backend_id,"frameId":frame_id}))
+}
