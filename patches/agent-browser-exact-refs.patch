+                        json!({"method":"Page.javascriptDialogOpening","sessionId":"S-SELECTED","params":{"type":"alert","message":"approved"}}),
+                    ];
+                    for event in events {
+                        socket.send(Message::Text(event.to_string())).await.unwrap();
+                    }
+                }
+                let result = match method {
+                    "Target.getTargets" => json!({"targetInfos":[{"targetId":"T-SELECTED","type":"page","title":"selected","url":"https://selected.test/","browserContextId":"C-APPROVED"}]}),
