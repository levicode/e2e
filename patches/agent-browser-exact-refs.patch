+/// Browser-context boundary, immutable after initial discovery. The literal
+/// `default` remains an absent command context ID. A separately proven metadata
+/// ID can identify its targets without treating default-context commands as incognito.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct CdpScope {
+    pub initial_target: String,
+    pub context_id: Option<String>,
+}
+
+impl CdpScope {
+    pub fn from_command(cmd: &Value) -> Result<Option<Self>, String> {
+        let target = cmd.get("cdpTarget");
+        let context = cmd.get("cdpContext");
+        if target.is_none() && context.is_none() { return Ok(None); }
+        fn valid(v: &Value) -> Option<&str> {
+            v.as_str().filter(|id| !id.is_empty() && !id.starts_with("--")
+                && !id.chars().any(|c| c.is_whitespace() || c.is_control()))
+        }
+        let target = target.and_then(valid).ok_or("Invalid CDP target/context scope")?;
+        let context = context.and_then(valid).ok_or("Invalid CDP target/context scope")?;
+        Ok(Some(Self {
+            initial_target: target.to_string(),
+            context_id: (context != "default").then(|| context.to_string()),
+        }))
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct ScopedSession {
+    target_id: String,
+    parent_session: Option<String>,
+}
+
+#[derive(Default)]
+struct ScopedSessions {
+    invalidated: bool,
+    live: HashMap<String, ScopedSession>,
+    revoked: HashSet<String>,
+    revoked_targets: HashSet<String>,
+}
+
+/// Shared by the synchronous drain and asynchronous interception subscriber.
+/// Unknown or replayed child attachments cannot obtain domain/input authority.
+#[derive(Clone)]
+pub(super) struct CdpScopeGuard {
+    scope: Option<CdpScope>,
+    resolved_default_context: Option<String>,
+    sessions: Arc<std::sync::Mutex<ScopedSessions>>,
+}
+
+impl CdpScopeGuard {
+    pub fn new(scope: Option<CdpScope>) -> Self {
+        Self { scope, resolved_default_context: None, sessions: Arc::new(std::sync::Mutex::new(ScopedSessions::default())) }
+    }
+
+    pub fn accepts_target(&self, target: &TargetInfo) -> bool {
+        self.scope.as_ref().map_or(true, |scope| should_track_target(target)
+            && target.browser_context_id.as_ref() == scope.context_id.as_ref().or(self.resolved_default_context.as_ref())
+            && self.sessions.lock().map(|state| !state.invalidated && !state.revoked_targets.contains(&target.target_id)).unwrap_or(false))
+    }
+
+    pub fn accepts_session(&self, session: Option<&str>) -> bool {
+        if self.scope.is_none() { return true; }
+        let Some(session) = session else { return false; };
+        self.sessions.lock().map(|state| !state.invalidated && state.live.contains_key(session)).unwrap_or(false)
+    }
+
+    /// Call only after validating target metadata or creating the target in
+    /// this manager's immutable context. It does not authorize arbitrary ids.
+    pub fn register_session(&self, session: &str, target: &str, parent: Option<&str>) -> bool {
+        if self.scope.is_none() { return true; }
+        let Ok(mut state) = self.sessions.lock() else { return false; };
+        if state.invalidated || state.revoked.contains(session) || state.revoked_targets.contains(target) || session.is_empty() { return false; }
+        if parent.is_some_and(|sid| !state.live.contains_key(sid)) { return false; }
+        let proof = ScopedSession { target_id: target.to_string(), parent_session: parent.map(str::to_string) };
+        if let Some(previous) = state.live.get(session) { return previous == &proof; }
+        state.live.insert(session.to_string(), proof);
+        true
+    }
+
+    pub fn accept_attachment(&self, parent: Option<&str>, target: Option<&TargetInfo>, session: &str) -> bool {
+        let Some(scope) = &self.scope else { return true; };
+        let Some(target) = target else { return false; };
+        match target.target_type.as_str() {
+            "page" | "webview" => {
+                if !self.accepts_target(target) { return false; }
+            }
+            "iframe" | "worker" | "shared_worker" | "service_worker" => {
+                if parent.is_none() || !self.accepts_session(parent)
+                    || target.browser_context_id.as_ref().is_some_and(|id|
+                        Some(id) != scope.context_id.as_ref().or(self.resolved_default_context.as_ref()))
+                { return false; }
+            }
+            _ => return false,
+        }
+        self.register_session(session, &target.target_id, parent)
+    }
+
+    pub fn invalidate(&self) {
+        if self.scope.is_none() { return; }
+        if let Ok(mut state) = self.sessions.lock() {
+            state.invalidated = true;
+            state.live.clear();
+        }
+    }
+
+    pub fn revoke_session(&self, session: &str) {
+        if self.scope.is_none() { return; }
+        let Ok(mut state) = self.sessions.lock() else { return; };
+        let mut pending = vec![session.to_string()];
+        while let Some(sid) = pending.pop() {
+            state.revoked.insert(sid.clone());
+            let children: Vec<String> = state.live.iter()
+                .filter(|(_, proof)| proof.parent_session.as_deref() == Some(sid.as_str()))
+                .map(|(child, _)| child.clone()).collect();
+            state.live.remove(&sid);
+            pending.extend(children);
+        }
+    }
+
+    pub fn revoke_target(&self, target: &str) {
+        if self.scope.is_none() { return; }
+        let sessions: Vec<String> = match self.sessions.lock() {
+            Ok(mut state) => {
+                state.revoked_targets.insert(target.to_string());
+                state.live.iter().filter(|(_, proof)| proof.target_id == target)
+                    .map(|(sid, _)| sid.clone()).collect()
+            },
+            Err(_) => return,
+        };
+        for sid in sessions { self.revoke_session(&sid); }
+    }
+}
